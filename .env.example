# Copy to .env (never commit .env)
DB_PASSWORD=change-me-long-random
PUBLIC_URL=https://signer.example.gov.in
# Optional: first administrator password (otherwise a random one is printed in the log once)
ADMIN_INITIAL_PASSWORD=
